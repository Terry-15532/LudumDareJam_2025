    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AvgDiff",
    "m_FunctionSource": "",
    "m_FunctionBody": "float3 d=0;\n\nd += abs(Center-Col1);\nd += abs(Center-Col2);\nd += abs(Center-Col3);\nd += abs(Center-Col4);\n\ndiff = d/4;"
}

